      <column caption='PRODUCT_TERMS' datatype='table' name='[__tableau_internal_object_id__].[PRODUCT_TERMS (MISC.PRODUCT_TERMS)_1311EFB1F5994FF2BD7DA554D7A049B5]' role='measure' type='quantitative' />
      <column caption='filter_ec2_old' datatype='boolean' name='[filter_ec2 (copy)_174584899112693761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [SERVICE_CODE] = &apos;AmazonEC2&apos; and [PRODUCT_FAMILY] = &apos;Compute Instance&apos; then &#10;&#10;[PRICING_TYPE] = [Parameters].[Parameter 9]&#10;and &#10;[ATR_OPERATINGSYSTEM] = [Parameters].[Parameter 11]&#10;and &#10;[ATR_CAPACITYSTATUS] = &apos;Used&apos;&#10;and &#10;[ATR_PREINSTALLEDSW] = &apos;NA&apos;&#10;and&#10;[ATR_LICENSEMODEL] = &apos;No License required&apos;&#10;and&#10;&#10;if [PRICING_TYPE] = &apos;Reserved&apos; then&#10;&#10;    case [Parameters].[Parameter 1]&#10;    when 1 then [LEASE_CONTRACT_LENGTH] = &apos;1yr&apos;&#10;    when 3 then [LEASE_CONTRACT_LENGTH] = &apos;3yr&apos;&#10;    end&#10;&#10;    and [OFFERING_CLASS] = [Parameters].[Parameter 3]&#10;&#10;    and [PURCHASE_OPTION] = [Parameters].[Parameter 4]&#10;&#10;elseif [PRICING_TYPE] = &apos;OnDemand&apos; then &#10;&#10;    ISNULL([LEASE_CONTRACT_LENGTH])&#10;    and ISNULL([OFFERING_CLASS])&#10;    and ISNULL([PURCHASE_OPTION])&#10;&#10;end&#10;&#10;else TRUE&#10;end&#10;&#10;/*&#10;if [Service Code] = &apos;AmazonEC2&apos; and [Product Family] = &apos;Compute Instance&apos; then &#10;&#10;[Pricing Type] = [P_EC2 Instance Pricing Type]&#10;and &#10;[Atr Operatingsystem] = [P_EC2 Instance Operating System]&#10;and &#10;[Atr Capacitystatus] = &apos;Used&apos;&#10;and &#10;[Atr Preinstalledsw] = &apos;NA&apos;&#10;and&#10;[Atr Licensemodel] = &apos;No License required&apos;&#10;and &#10;&#10;if [Pricing Type] = &apos;Reserved&apos; then&#10;&#10;    case [P_Number of Years]&#10;    when 1 then [Lease Contract Length] = &apos;1yr&apos;&#10;    when 3 then [Lease Contract Length] = &apos;3yr&apos;&#10;    end&#10;&#10;    and [Offering Class] = [P_EC2 Instance Offering Class]&#10;&#10;    and [Purchase Option] = [P_EC2 Instance Purchase Option]&#10;&#10;elseif [Pricing Type] = &apos;OnDemand&apos; then &#10;&#10;    ISNULL([Lease Contract Length])&#10;    and ISNULL([Offering Class])&#10;    and ISNULL([Purchase Option])&#10;&#10
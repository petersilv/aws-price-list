            <column caption='Purchase Option' datatype='string' name='[PURCHASE_OPTION]' role='dimension' type='nominal' />
            <column caption='Service Code' datatype='string' name='[SERVICE_CODE]' role='dimension' type='nominal' />
            <column caption='Unit' datatype='string' name='[UNIT]' role='dimension' type='nominal' />

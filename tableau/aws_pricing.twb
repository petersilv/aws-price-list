          <datasource-dependencies datasource='federated.1iiuim80cdohbt14q9y8u1gflxwz'>
            <column caption='Atr Capacitystatus' datatype='string' name='[ATR_CAPACITYSTATUS]' role='dimension' type='nominal' />

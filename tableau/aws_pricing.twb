      <column caption='Price_USD_Display' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Price_GBP_Display (copy)_406520252505538566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Old calc&#10;//if [P_Show Customer Price] &#10;//then FLOOR( [Price_USD_Customer] / 100 ) * 100&#10;//else SUM([Price_USD])&#10;//end&#10;&#10;SUM([Calculation_4935382246695366659])' />
      </column>

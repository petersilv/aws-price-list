      <column caption='Price_GBP' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Price (copy)_406520252491755520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 14] then [Price (copy)_6342546074388611089] * [Parameters].[Parameter 15] end' />
      </column>
      <column caption='Price' datatype='real' name='[Price (copy)_6342546074388611089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// EC2 Instance &#10;if [SERVICE_CODE] = &apos;AmazonEC2&apos;&#10;and [PRODUCT_FAMILY] = &apos;Compute Instance&apos;&#10;then &#10;    // The additional IF is just to filter to a single row to get the LOD values from&#10;    if [ATR_INSTANCETYPE] = [Parameters].[P_EC2 Instance Type (copy)_6342546074362531843] and [UNIT] = &apos;Hrs&apos; &#10;    then [Calculation_6342546074361892865]&#10;    end&#10;&#10;// EC2 Storage&#10;elseif [SERVICE_CODE] = &apos;AmazonEC2&apos;&#10;and [PRODUCT_FAMILY] = &apos;Storage&apos;&#10;and [UNIT] = &apos;GB-Mo&apos;&#10;then [PRICE_PER_UNIT] * [Parameters].[Parameter 5] * [Calculation_6571877811976683538] * 12 * [Parameters].[Parameter 1]&#10;&#10;// S3&#10;elseif [SERVICE_CODE] = &apos;AmazonS3&apos;&#10;and [PRODUCT_FAMILY] = &apos;Storage&apos;&#10;and [UNIT] = &apos;GB-Mo&apos;&#10;then [PRICE_PER_UNIT] * [Parameters].[Parameter 6] * 12 * [Parameters].[Parameter 1]&#10;&#10;// Load Balancers&#10;elseif [SERVICE_CODE] = &apos;AWSELB&apos;&#10;and [UNIT] = &apos;Hrs&apos;&#10;then [PRICE_PER_UNIT] * 8760 * [Calculation_5106448701783244800] * [Parameters].[Parameter 1]&#10;&#10;// NAT Gateway&#10;elseif [SERVICE_CODE] = &apos;AmazonEC2&apos;&#10;and [PRODUCT_FAMILY] = &apos;NAT Gateway&apos;&#10;and [UNIT] = &apos;Hrs&apos;&#10;then [PRICE_PER_UNIT] * 8760 * [Calculation_5106448701783547905] * [Parameters].[Parameter 1]&#10;&#10;// Site-to-Site VPN&#10;elseif [SERVICE_CODE] = &apos;AmazonVPC&apos;&#10;and [UNIT] = &apos;Hourly&apos;&#10;then [PRICE_PER_UNIT] * 8760 * [Parameters].[Parameter 8] * [Parameters].[Parameter 1]&#10;&#10;&#10;end' />
      </column>
      <column caption='Price_GBP_PerYear' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Price Per Year_USD (copy)_406520252493524994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_406520252505251845] / [Parameters].[Parameter 1]' />

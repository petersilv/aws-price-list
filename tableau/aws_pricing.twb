            <column caption='Price - Total - USD' datatype='integer' name='[Calculation_1572319265402302464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not [Parameters].[Parameter 2] then [Calculation_174584899463200773] end' />
            </column>
            <column caption='Price - Per Year - USD - Display' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_1572319265402642433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1572319265402904578] / [Parameters].[Parameter 1]' />
            </column>
            <column caption='Price - Total - USD - Display' datatype='integer' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_1572319265402904578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1572319265402302464])' />
            </column>
            <column caption='Price - Total - GBP' datatype='real' name='[Calculation_1572319265406185475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] then [Calculation_174584899463200773] * [Parameters].[Parameter 15] end' />
            </column>
            <column caption='Price - Total - GBP - Display' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Calculation_1572319265408258052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1572319265406185475])' />
            </column>
            <column caption='Price - Per Year - GBP - Display' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Calculation_1572319265408684037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1572319265408258052] / [Parameters].[Parameter 1]' />
            </column>
            <column caption='Price - Total' datatype='integer' name='[Calculation_174584899463200773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// EC2 Instance &#10;if [SERVICE_CODE] = &apos;AmazonEC2&apos;&#10;and [PRODUCT_FAMILY] = &apos;Compute Instance&apos;&#10;then &#10;    // The additional IF is just to filter to a single row to get the LOD values from&#10;    if [ATR_INSTANCETYPE] = [Parameters].[Parameter 7] and [UNIT] = &apos;Hrs&apos; &#10;    then [Calculation_174584899463847942]&#10;    end&#10;&#10;end&#10;&#10;/*&#10;&#10;// EC2 Storage&#10;elseif [Service Code] = &apos;AmazonEC2&apos;&#10;and [Product Family] = &apos;Storage&apos;&#10;and [Unit] = &apos;GB-Mo&apos;&#10;then [Price Per Unit] * [P_EC2 Storage per Instance (GB)] * [Node_Count_Total] * 12 * [P_Number of Years]&#10;&#10;// S3&#10;elseif [Service Code] = &apos;AmazonS3&apos;&#10;and [Product Family] = &apos;Storage&apos;&#10;and [Unit] = &apos;GB-Mo&apos;&#10;then [Price Per Unit] * [P_S3 Storage (GB)] * 12 * [P_Number of Years]&#10;&#10;// Load Balancers&#10;elseif [Service Code] = &apos;AWSELB&apos;&#10;and [Unit] = &apos;Hrs&apos;&#10;then [Price Per Unit] * 8760 * [Count_Load Balancers] * [P_Number of Years]&#10;&#10;// NAT Gateway&#10;elseif [Service Code] = &apos;AmazonEC2&apos;&#10;and [Product Family] = &apos;NAT Gateway&apos;&#10;and [Unit] = &apos;Hrs&apos;&#10;then [Price Per Unit] * 8760 * [Count_NAT Gateways] * [P_Number of Years]&#10;&#10;// Site-to-Site VPN&#10;elseif [Service Code] = &apos;AmazonVPC&apos;&#10;and [Unit] = &apos;Hourly&apos;&#10;then [Price Per Unit] * 8760 * [P_Deploy Site-to-Site VPN] * [P_Number of Years]&#10;&#10;*/' />
            </column>
            <column caption='Price EC2 All Nodes' datatype='integer' name='[Calculation_174584899463847942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4940941415770066944]&#10;//+ [price_prod1]&#10;//+ [price_prod1]' />
            </column>
            <column caption='Filter EC2 Instance' datatype='boolean' name='[Calculation_174584899741618184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [SERVICE_CODE] = &apos;AmazonEC2&apos; and [PRODUCT_FAMILY] = &apos;Compute Instance&apos; then &#10;&#10;[PRICING_TYPE] = [Parameters].[Parameter 5]&#10;and &#10;[ATR_OPERATINGSYSTEM] = [Parameters].[Parameter 6]&#10;and &#10;[ATR_CAPACITYSTATUS] = &apos;Used&apos;&#10;and &#10;[ATR_PREINSTALLEDSW] = &apos;NA&apos;&#10;and&#10;[ATR_LICENSEMODEL] = &apos;No License required&apos;&#10;and&#10;&#10;&#10;if [PRICING_TYPE] = &apos;Reserved&apos; then&#10;&#10;    case [Parameters].[Parameter 1]&#10;    when 1 then [LEASE_CONTRACT_LENGTH] = &apos;1yr&apos;&#10;    when 3 then [LEASE_CONTRACT_LENGTH] = &apos;3yr&apos;&#10;    end&#10;&#10;    and [OFFERING_CLASS] = [Parameters].[Parameter 3]&#10;&#10;    and [PURCHASE_OPTION] = [Parameters].[Parameter 4]&#10;&#10;elseif [PRICING_TYPE] = &apos;OnDemand&apos; then &#10;&#10;    ISNULL([LEASE_CONTRACT_LENGTH])&#10;    and ISNULL([OFFERING_CLASS])&#10;    and ISNULL([PURCHASE_OPTION])&#10;&#10;end&#10;&#10;else TRUE&#10;end' />
            </column>
            <column caption='Price Prod1' datatype='integer' name='[Calculation_4940941415770066944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ SUM(&#10;if [ATR_INSTANCETYPE] = [Parameters].[Parameter 7] &#10;and [Calculation_174584899741618184]&#10;then [Calculation_871094727506669571] &#10;else 0&#10;end&#10;) }' />
            </column>
            <column caption='Price EC2' datatype='integer' name='[Calculation_871094727506669571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [SERVICE_CODE] = &apos;AmazonEC2&apos;&#10;and [PRODUCT_FAMILY] = &apos;Compute Instance&apos;&#10;&#10;then &#10;&#10;    if [UNIT] = &apos;Hrs&apos;&#10;    then [PRICE_PER_UNIT] * 8760 * [Parameters].[Parameter 1]&#10;&#10;    elseif [UNIT] = &apos;Quantity&apos;&#10;    then [PRICE_PER_UNIT]&#10;&#10;    end&#10;&#10;end' />
            </column>
            <column caption='Lease Contract Length' datatype='string' name='[LEASE_CONTRACT_LENGTH]' role='dimension' type='nominal' />
            <column caption='Offering Class' datatype='string' name='[OFFERING_CLASS]' role='dimension' type='nominal' />
            <column caption='Price Per Unit' datatype='integer' name='[PRICE_PER_UNIT]' role='measure' type='quantitative' />
            <column caption='Pricing Type' datatype='string' name='[PRICING_TYPE]' role='dimension' type='nominal' />

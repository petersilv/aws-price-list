            <column-instance column='[Calculation_1572319265402904578]' derivation='User' name='[usr:Calculation_1572319265402904578:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1572319265408258052]' derivation='User' name='[usr:Calculation_1572319265408258052:qk]' pivot='key' type='quantitative' />

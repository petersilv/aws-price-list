        <calculation class='tableau' formula='if [SERVICE_CODE] = &apos;AmazonEC2&apos; and [PRODUCT_FAMILY] = &apos;Compute Instance&apos; then &#10;&#10;[PRICING_TYPE] = [Parameters].[Parameter 9]&#10;and &#10;[ATR_OPERATINGSYSTEM] = [Parameters].[Parameter 11]&#10;and &#10;[ATR_CAPACITYSTATUS] = &apos;Used&apos;&#10;and &#10;[ATR_PREINSTALLEDSW] = &apos;NA&apos;&#10;and&#10;[ATR_LICENSEMODEL] = &apos;No License required&apos;&#10;and &#10;&#10;if [PRICING_TYPE] = &apos;Reserved&apos; then&#10;&#10;    case [Parameters].[Parameter 1]&#10;    when 1 then [LEASE_CONTRACT_LENGTH] = &apos;1yr&apos;&#10;    when 3 then [LEASE_CONTRACT_LENGTH] = &apos;3yr&apos;&#10;    end&#10;&#10;    and [OFFERING_CLASS] = [Parameters].[Parameter 3]&#10;&#10;    and [PURCHASE_OPTION] = [Parameters].[Parameter 4]&#10;&#10;elseif [PRICING_TYPE] = &apos;OnDemand&apos; then &#10;&#10;    ISNULL([LEASE_CONTRACT_LENGTH])&#10;    and ISNULL([OFFERING_CLASS])&#10;    and ISNULL([PURCHASE_OPTION])&#10;&#10;end&#10;&#10;else TRUE&#10;end' />
      </column>
